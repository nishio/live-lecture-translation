{
  "configuration": {
    "language": "en",
    "provider": "openai",
    "model": "gpt-6.1-sol",
    "chunk_seconds": 15,
    "analysis_interval": 60,
    "translation_interval": 15,
    "provisional_refresh_seconds": 3.0,
    "provisional_window_seconds": 15.0,
    "continuous_translation": true,
    "initial_translation_first": true,
    "parallel_cloud_stages": true,
    "translation_source_policy_version": 1,
    "translation_max_wait_seconds": 30.0,
    "translation_lookahead_seconds": 2.0,
    "replay": true,
    "pace": 1
  }
}
